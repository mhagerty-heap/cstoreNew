<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - ShopExpress Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<div class="d-flex">
  <% const activePage = 'agent-scenarios'; %>
  <%- include('../sidebar') %>
  <div class="flex-grow-1 bg-light" style="min-height:100vh;">
    <div class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
      <h5 class="mb-0 fw-bold"><i class="bi bi-robot me-2 text-primary"></i><%= title %></h5>
      <a href="/admin/agent-scenarios" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back
      </a>
    </div>
    <div class="p-4">
      <%- include('../../partials/flash') %>

      <form action="<%= scenario ? '/admin/agent-scenarios/' + scenario.id + '?_method=PUT' : '/admin/agent-scenarios' %>" method="POST" id="scenario-form">
        <% if (scenario) { %><input type="hidden" name="_method" value="PUT"><% } %>

        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Scenario Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" name="name" id="nameInput" required autofocus
                       value="<%= scenario ? scenario.name : '' %>"
                       oninput="if(!slugEdited) document.getElementById('slugInput').value = this.value.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Slug</label>
                <input type="text" class="form-control font-monospace" name="slug" id="slugInput"
                       value="<%= scenario ? scenario.slug : '' %>" oninput="slugEdited = true">
                <small class="text-muted">Activate on the storefront with <code>?aiScenario=&lt;slug&gt;</code>.</small>
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold">Greeting</label>
                <textarea class="form-control" name="greeting_text" rows="2"><%= scenario ? scenario.greeting_text : "Hi there! I'm the CStore AI assistant. What can I help you find today?" %></textarea>
                <small class="text-muted">First message shown when the chat panel opens.</small>
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold">Completion message</label>
                <textarea class="form-control" name="completion_text" rows="2"><%= scenario ? scenario.completion_text : 'If you need further assistance, please contact our support team!' %></textarea>
                <small class="text-muted">Shown once the script runs out of steps.</small>
              </div>
              <div class="col-12">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" role="switch" name="active" id="activeSwitch" value="1" <%= !scenario || scenario.active ? 'checked' : '' %>>
                  <label class="form-check-label" for="activeSwitch">Active (available via <code>?aiScenario=</code>)</label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="mb-0 fw-bold">Steps</h6>
            <small class="text-muted">
              <strong>Free Text</strong>: any input from the user advances to this step's response, content ignored.
              <strong>Chips</strong>: admin-defined buttons, each can branch to any step (or end the conversation).
            </small>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm flex-shrink-0" id="addStepBtn">
            <i class="bi bi-plus-lg me-1"></i>Add Step
          </button>
        </div>
        <div id="stepsContainer"></div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary flex-grow-1">
            <i class="bi bi-save me-2"></i><%= scenario ? 'Update Scenario' : 'Create Scenario' %>
          </button>
          <a href="/admin/agent-scenarios" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script id="initial-scenario-data" type="application/json"><%- JSON.stringify(scenario ? scenario.steps : []).replace(/</g, '\\u003c') %></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>let slugEdited = <%= scenario ? 'true' : 'false' %>;</script>
<script src="/js/admin-agent-scenario-form.js"></script>
</body>
</html>

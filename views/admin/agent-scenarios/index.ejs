<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - ShopExpress Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<div class="d-flex">
  <% const activePage = 'agent-scenarios'; %>
  <%- include('../sidebar') %>
  <div class="flex-grow-1 bg-light" style="min-height:100vh;">
    <div class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
      <h5 class="mb-0 fw-bold"><i class="bi bi-robot me-2 text-primary"></i>AI Agent Scenarios</h5>
      <a href="/admin/agent-scenarios/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Scenario
      </a>
    </div>
    <div class="p-4">
      <%- include('../../partials/flash') %>
      <div class="alert alert-info d-flex align-items-start gap-2 small">
        <i class="bi bi-info-circle mt-1"></i>
        <div>
          Open the storefront with <code>?aiScenario=&lt;slug&gt;</code> to activate the chat icon for that browser
          session (e.g. <code>/?aiScenario=back-in-stock-help</code>). Nothing is tied to any user account.
        </div>
      </div>
      <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
          <table class="table mb-0 align-middle">
            <thead class="bg-light">
              <tr>
                <th class="ps-3 py-3">Name</th>
                <th class="py-3">Slug</th>
                <th class="py-3 text-center">Steps</th>
                <th class="py-3 text-center">Active</th>
                <th class="py-3 text-end pe-3">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!scenarios || scenarios.length === 0) { %>
                <tr><td colspan="5" class="text-center py-4 text-muted">No scenarios yet. <a href="/admin/agent-scenarios/new">Create one</a></td></tr>
              <% } else { %>
                <% scenarios.forEach(s => { %>
                  <tr>
                    <td class="ps-3 fw-semibold"><%= s.name %></td>
                    <td class="text-muted small font-monospace">
                      <a href="/?aiScenario=<%= s.slug %>" target="_blank" rel="noopener" title="Open storefront with this scenario active">
                        <%= s.slug %>
                      </a>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-secondary rounded-pill"><%= s.step_count %></span>
                    </td>
                    <td class="text-center">
                      <% if (s.active) { %>
                        <span class="badge bg-success">Active</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Disabled</span>
                      <% } %>
                    </td>
                    <td class="text-end pe-3">
                      <a href="/admin/agent-scenarios/<%= s.id %>/edit" class="btn btn-outline-primary btn-sm me-1">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <form action="/admin/agent-scenarios/<%= s.id %>?_method=DELETE" method="POST" class="d-inline"
                            onsubmit="return confirm('Delete this scenario?')">
                        <input type="hidden" name="_method" value="DELETE">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                          <i class="bi bi-trash3"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<!-- Shop by Category -->
<% if (categories && categories.length > 0) { %>
<section class="py-5">
  <div class="container">
    <h2 class="section-title">Shop by Category</h2>
    <div class="row g-3<%= (typeof botView !== 'undefined' && botView) ? ' bot-hidden' : '' %>">
      <% const catImageMap = { sports: 'sports_cat.jpg', running: 'running_cat.jpg', lifestyle: 'lifestyles_cat.jpg', classics: 'classics_cat.jpg', basketball: 'basketball_cat.jpg', golf: 'golf_cat.jpg' }; %>
      <% categories.forEach((cat, i) => { %>
        <div class="col-6 col-md-4 col-lg-2">
          <a href="/shop?category=<%= cat.slug %>" class="category-tile" id="home-cat-<%= cat.slug %>">
            <img src="/images/<%= catImageMap[cat.slug] || cat.slug + '_cat.jpg' %>" alt="<%= cat.name %>" loading="lazy">
            <div class="category-tile-overlay">
              <span class="category-tile-name"><%= cat.name %></span>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

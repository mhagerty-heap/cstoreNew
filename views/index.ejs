<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <%- include('partials/home-hero') %>

  <!-- Trust Bar -->
  <div class="trust-bar border-bottom">
    <div class="container">
      <div class="row g-3">
        <div class="col-6 col-md-3">
          <div class="trust-item justify-content-center">
            <i class="bi bi-truck"></i>
            <div>
              <div class="label">Free Shipping</div>
              <div class="sub">On orders over $99</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="trust-item justify-content-center">
            <i class="bi bi-arrow-counterclockwise"></i>
            <div>
              <div class="label">Easy Returns</div>
              <div class="sub">30-day return policy</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="trust-item justify-content-center">
            <i class="bi bi-shield-lock"></i>
            <div>
              <div class="label">Secure Checkout</div>
              <div class="sub">100% safe &amp; encrypted</div>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="trust-item justify-content-center">
            <i class="bi bi-headset"></i>
            <div>
              <div class="label">24/7 Support</div>
              <div class="sub">Always here for you</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Flash messages -->
  <div class="container mt-3">
    <%- include('partials/flash') %>
  </div>

  <!-- Shop by Category -->
  <% if (categories && categories.length > 0) { %>
  <section class="py-5">
    <div class="container">
      <h2 class="section-title">Shop by Category</h2>
      <div class="row g-3">
        <% const catImageMap = { sports: 'sports_cat.jpg', running: 'running_cat.jpg', lifestyle: 'lifestyles_cat.jpg', classics: 'classics_cat.jpg', basketball: 'basketball_cat.jpg', golf: 'golf_cat.jpg' }; %>
        <% categories.forEach((cat, i) => { %>
          <div class="col-6 col-md-4 col-lg-2">
            <a href="/shop?category=<%= cat.slug %>" class="category-tile" id="home-cat-<%= cat.slug %>">
              <img src="/images/<%= catImageMap[cat.slug] || cat.slug + '_cat.jpg' %>" alt="<%= cat.name %>" loading="lazy">
              <div class="category-tile-overlay">
                <span class="category-tile-name"><%= cat.name %></span>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Featured Products -->
  <% if (featured && featured.length > 0) { %>
  <section class="py-5" style="background:var(--light-gray)">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end mb-4">
        <h2 class="section-title mb-0">Featured Products</h2>
        <a href="/shop" style="font-size:13px;font-weight:600;color:var(--red);text-decoration:none;">View All <i class="bi bi-arrow-right"></i></a>
      </div>
      <div class="row g-3">
        <% featured.forEach(product => { %>
          <div class="col-6 col-md-4 col-lg-3">
            <%- include('partials/product-card', { product }) %>
          </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <%- include('partials/home-promo-banners') %>

  <!-- Best Selling / Sale Products -->
  <% if (sale && sale.length > 0) { %>
  <section class="py-5" style="background:var(--light-gray)">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end mb-4">
        <h2 class="section-title mb-0" id="best-selling-heading">Best Selling</h2>
        <a href="/shop" style="font-size:13px;font-weight:600;color:var(--red);text-decoration:none;" id="best-selling-view-all">View All <i class="bi bi-arrow-right"></i></a>
      </div>
      <div class="row g-3">
        <% sale.forEach(product => { %>
          <div class="col-6 col-md-4 col-lg-3">
            <%- include('partials/product-card', { product }) %>
          </div>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <%- include('partials/home-sport-promos') %>

  <%- include('partials/home-newsletter') %>
</main>

<%- include('partials/footer') %>
</body>
</html>
